#!/bin/sh
# ============================================================
# BLINDAGEM DO CÓDIGO — roda sozinho antes de cada commit (git, VS Code, qualquer cliente).
# 1. confere a sintaxe de todos os arquivos PHP (tests/lint.php);
# 2. roda o teste rápido (tests/smoke.php: regras, banco e páginas — Apache e MySQL ligados);
# 3. roda as jornadas (tests/jornadas.php: cadastro, login, currículo, candidatura, extração e exclusão de conta).
# Se algo falhar, o commit NÃO é feito e aparece o motivo. Os relatórios completos ficam em
# .git/smoke_ultimo.txt e .git/jornadas_ultimo.txt. Emergência (ex.: XAMPP desligado): git commit --no-verify
# Ativado com: git config core.hooksPath .githooks
# ============================================================
PHP="/c/xampp/php/php.exe"
[ -x "$PHP" ] || PHP="C:/xampp/php/php.exe"
[ -x "$PHP" ] || PHP="php"

echo "Blindagem: conferindo a sintaxe dos arquivos PHP..."
"$PHP" tests/lint.php || { echo ""; echo "COMMIT BLOQUEADO: erro de sintaxe no PHP (veja acima)."; exit 1; }

echo "Blindagem: rodando o teste rapido (tests/smoke.php)..."
"$PHP" tests/smoke.php > .git/smoke_ultimo.txt 2>&1
if [ $? -ne 0 ]; then
    grep -E "FALHA|RESULTADO" .git/smoke_ultimo.txt
    echo ""
    echo "COMMIT BLOQUEADO: o teste rapido falhou. Relatorio completo: .git/smoke_ultimo.txt"
    echo "(Apache e MySQL precisam estar ligados no XAMPP.)"
    exit 1
fi
grep -E "RESULTADO" .git/smoke_ultimo.txt

echo "Blindagem: rodando as jornadas (tests/jornadas.php)..."
# A extensão zip (usada só pelo teste, para montar um DOCX) costuma vir desligada no php.ini do XAMPP: liga só para esta execução.
ZIP=""; "$PHP" -r "exit(class_exists('ZipArchive') ? 0 : 1);" || ZIP="-d extension=zip"
"$PHP" $ZIP tests/jornadas.php > .git/jornadas_ultimo.txt 2>&1
if [ $? -ne 0 ]; then
    grep -E "FALHA|RESULTADO" .git/jornadas_ultimo.txt
    echo ""
    echo "COMMIT BLOQUEADO: uma jornada falhou. Relatorio completo: .git/jornadas_ultimo.txt"
    exit 1
fi
grep -E "RESULTADO" .git/jornadas_ultimo.txt
exit 0
