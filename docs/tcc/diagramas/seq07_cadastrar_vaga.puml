@startuml
!include estilo.iuml
mainframe sd Cadastrar vaga (leitura do cartaz na plataforma)
autonumber "0:"
hide footbox

actor Empresa as E
boundary ":TelaVagas" as T
control ":LeitorCartaz\n(navegador)" as L
control ":EmpresaController" as C
control ":OcrImagem" as O
control ":ExtracaoVaga" as X
control ":Calibrador" as K
entity ":AssinaturaDAO" as S
entity ":VagaDAO" as D
control ":MatchService" as M
E -> T ++ : escolher a imagem do cartaz
T -> L ++ : ler(cartaz)
L -> L : carregar Tesseract.js (carregador amarelo)
L -> L : 4 leituras: normal e negativo × psm 3 e 11
L --> T -- : leituras (TSV) — carregador azul
T -> C ++ : vagas(acao = ler_cartaz, cartaz, leituras)
C -> O ++ : leiturasDoNavegador(leituras)
O --> C -- : leituras validadas
C -> X ++ : doImagem(cartaz, leituras)
X -> K ++ : decidir(linha / área) · nomeConhecido("empresa")
K --> X -- : ajustes do calibrador
X --> C -- : campos da vaga + relatório
C --> T -- : formulário preenchido
T --> E -- : exibir para revisão
E -> T ++ : revisar e clicar em "Salvar vaga"
T -> C ++ : vagas(acao = salvar, dados)
C -> C : validar dados
C -> D ++ : buscarParecida(título, anunciante, cidade)
D --> C -- : null
C -> S ++ : podePublicarVaga(usuarioId, perfilId)
S --> C -- : permitido
C -> D ++ : salvarComLimite(dados, 0, limite)
D --> C -- : vagaId
C -> M ++ : recalcularVaga(vagaId)
M --> C -- : nº de candidatos
C --> T -- : "Vaga publicada"
T --> E -- : exibir mensagem
@enduml
