@startuml
!include estilo.iuml
mainframe uc Acesso à conta
left to right direction
actor Candidato as C
actor Empresa as E
actor Administrador as A
rectangle "Conecta Vagas DF" {
  usecase "Cadastrar conta\n(candidato ou empresa)" as CC
  usecase "Aceitar termo LGPD" as T
  usecase "Solicitar redefinição\nde senha" as S
  usecase "Redefinir senha\n(link com token de uso único)" as R
}
C -- CC
E -- CC
C -- S
E -- S
A -- S
C -- R
E -- R
A -- R
CC ..> T : <<include>>
@enduml
