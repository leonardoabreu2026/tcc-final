@startuml
!include estilo.iuml
mainframe sd Manter usuário
autonumber "0:"
hide footbox

actor Administrador as A
boundary ":TelaUsuarios" as T
control ":AdminController" as C
entity ":UsuarioDAO" as D
A -> T ++ : preencher dados do usuário
T -> C ++ : usuarios(acao = salvar, dados)
C -> C : validar dados
C -> D ++ : cadastrar() / atualizar()
D --> C -- : true
C --> T -- : "Usuário salvo."
T --> A -- : exibir mensagem
A -> T ++ : clicar em "Cancelar conta"
T -> C ++ : usuarios(acao = cancelar, id)
C -> C : impedir cancelar a própria conta\ne o último administrador
C -> D ++ : alterarAtivo(id, false)
D --> C -- : sem erro (nada é apagado:\na conta só é bloqueada)
C --> T -- : "Conta cancelada."
T --> A -- : exibir mensagem
@enduml
