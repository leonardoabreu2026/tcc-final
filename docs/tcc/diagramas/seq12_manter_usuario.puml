@startuml
!include estilo.iuml
mainframe sd Manter usuário
autonumber "0:"
hide footbox

actor Administrador as A
boundary ":TelaUsuarios" as T
control ":AdminController" as C
entity ":UsuarioDAO" as D
A -> T ++ : preencher dados do usuário
T -> C ++ : usuarios(acao = salvar, dados)
C -> C : validar dados
C -> D ++ : cadastrar() / atualizar()
D --> C -- : true
C --> T -- : "Usuário salvo."
T --> A -- : exibir mensagem
A -> T ++ : clicar em "Excluir"
T -> C ++ : usuarios(acao = excluir, id)
C -> C : impedir excluir a própria conta\ne o último administrador
C -> D ++ : excluir(id)
note right of D : cascata: perfil, currículos,\nvagas e candidaturas; os termos\ndo calibrador ficam (sem autor)
D --> C -- : true
C --> T -- : "Usuário excluído."
T --> A -- : exibir mensagem
@enduml
