@startuml
!include estilo.iuml
mainframe sd Calibrar as máquinas de extração
autonumber "0:"
hide footbox

actor Administrador as A
boundary ":TelaCalibrador" as T
control ":CalibradorController" as C
entity ":CalibracaoDAO" as D
control ":ExtracaoVaga" as X
control ":Calibrador" as K
A -> T ++ : informar o termo e para onde vai
T -> C ++ : painel(acao = salvar, termo, destino)
C -> C : validar_csrf() e destinoValido()
C -> D ++ : salvar(dados, id, usuarioId)
D --> C -- : id do termo
C --> T -- : "Termo salvo: já vale na próxima extração."
T --> A -- : exibir mensagem
A -> T ++ : colar um anúncio em "Testar as máquinas"
T -> C ++ : painel(acao = testar, maquina = vaga, texto)
C -> X ++ : doTexto(texto)
opt nenhuma regra achou a empresa
  X -> K ++ : nomeConhecido("empresa", texto)
  K -> D ++ : nomesConhecidos("empresa")
  D --> K -- : anunciantes e nomes fantasia
  K --> X -- : empresa já cadastrada
end
X -> K ++ : decidir("vaga_linha", linha, palpiteDaRegra)
K -> D ++ : ativos()
D --> K -- : termos ativos
K --> X -- : campo do termo calibrado
X --> C -- : campos da vaga + ajustes do calibrador
C --> T -- : resultado do teste (nada é salvo)
T --> A -- : exibir campos e "Ajustes do calibrador"
@enduml
