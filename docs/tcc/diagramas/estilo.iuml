' Estilo comum dos diagramas do TCC, no jeito do Astah UML: traço preto fino, fundo branco ou amarelo bem claro,
' fonte Arial, ator em boneco palito, sem sombra e sem cores fortes. Todos os .puml incluem este arquivo.
' Para gerar as imagens: java -jar plantuml.jar -tsvg *.puml   e   java -jar plantuml.jar -tpng *.puml
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam ArrowColor #000000
skinparam ArrowThickness 0.8
skinparam ArrowFontSize 11
skinparam ActorBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontSize 11
skinparam UsecaseBorderColor #000000
skinparam UsecaseBorderThickness 0.8
skinparam UsecaseBackgroundColor #FFFFE0
skinparam RectangleBorderColor #000000
skinparam RectangleBorderThickness 0.8
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleFontStyle plain
skinparam ClassBorderColor #000000
skinparam ClassBorderThickness 0.8
skinparam ClassBackgroundColor #FFFFE0
skinparam ClassHeaderBackgroundColor #FFFFE0
skinparam ComponentBorderColor #000000
skinparam ComponentBackgroundColor #FFFFE0
skinparam ComponentStyle uml2
skinparam ParticipantBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFE0
skinparam BoundaryBorderColor #000000
skinparam BoundaryBackgroundColor #FFFFE0
skinparam ControlBorderColor #000000
skinparam ControlBackgroundColor #FFFFE0
skinparam EntityBorderColor #000000
skinparam EntityBackgroundColor #FFFFE0
skinparam DatabaseBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFE0
skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBorderThickness 0.8
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupHeaderFontStyle plain
skinparam SequenceMessageAlignment left
skinparam NoteBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NodeBorderColor #000000
skinparam NodeBackgroundColor #FFFFFF
skinparam PackageBorderColor #000000
skinparam PackageBorderThickness 0.8
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageFontStyle plain
skinparam FolderBorderColor #000000
skinparam FolderBackgroundColor #FFFFE0
skinparam CloudBorderColor #000000
skinparam CloudBackgroundColor #FFFFFF
skinparam classAttributeIconSize 0
