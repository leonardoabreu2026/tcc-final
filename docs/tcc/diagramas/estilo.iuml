' Estilo comum dos diagramas do TCC (incluído por todos os .puml com !include estilo.iuml).
' Renderizar: java -jar plantuml.jar -tsvg *.puml   e   java -jar plantuml.jar -tpng *.puml
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #000000
skinparam ArrowFontSize 11
skinparam ActorBorderColor #000000
skinparam ActorBackgroundColor #FFFFCC
skinparam UsecaseBorderColor #000000
skinparam UsecaseBackgroundColor #FFFFCC
skinparam RectangleBorderColor #000000
skinparam RectangleBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFCC
skinparam ComponentBorderColor #000000
skinparam ComponentBackgroundColor #FFFFCC
skinparam ParticipantBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFCC
skinparam SequenceLifeLineBorderColor #000000
skinparam NoteBorderColor #000000
skinparam NoteBackgroundColor #FFFFCC
skinparam roundCorner 0
skinparam BoundaryBorderColor #000000
skinparam BoundaryBackgroundColor #FFFFCC
skinparam ControlBorderColor #000000
skinparam ControlBackgroundColor #FFFFCC
skinparam EntityBorderColor #000000
skinparam EntityBackgroundColor #FFFFCC
skinparam DatabaseBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFCC
skinparam NodeBorderColor #000000
skinparam NodeBackgroundColor #FFFFFF
skinparam PackageBorderColor #000000
skinparam PackageBackgroundColor #FFFFFF
skinparam FolderBorderColor #000000
skinparam FolderBackgroundColor #FFFFCC
skinparam classAttributeIconSize 0
skinparam SequenceGroupBackgroundColor #FFFFFF
