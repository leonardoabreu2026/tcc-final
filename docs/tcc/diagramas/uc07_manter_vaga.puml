@startuml
!include estilo.iuml
mainframe uc Manter vaga
left to right direction
actor Empresa as E
rectangle "Conecta Vagas DF" {
  usecase "Cadastrar vaga" as CV
  usecase "Extrair vaga do texto\ndo anúncio" as XT
  usecase "Ler cartaz no navegador\n(OCR, com carregador)" as LC
  usecase "Alterar vaga" as AV
  usecase "Excluir vaga" as EV
  usecase "Recalcular match\nda vaga" as RM
  usecase "Aplicar os padrões automáticos\n(linha sem pista, área,\nempresa já cadastrada)" as CB
}
actor Administrador as A
E -- CV
E -- AV
E -- EV
CV -- A
AV -- A
EV -- A
CV <.. XT : <<extend>>
CV <.. LC : <<extend>>
CV ..> RM : <<include>>
AV ..> RM : <<include>>
XT ..> CB : <<include>>
actor Sistema as SI
LC -- SI
CB -- SI
RM -- SI
@enduml
