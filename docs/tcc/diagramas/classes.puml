@startuml
!include estilo.iuml
mainframe pkg Diagrama de Classes
hide circle
skinparam linetype ortho
class Usuario {
  -id : int
  -nome : String
  -email : String
  -senha : String
  -tipo : String
  -telefone : String
  -ativo : boolean
  -ultimoAcesso : DateTime
  -createdAt : DateTime
  --
  +cadastrar() : int
  +autenticar(email, senha) : Usuario
  +senhaConfere(senha) : boolean
  +atualizar() : boolean
  +excluir() : boolean
  +redefinirSenha(token, senha) : boolean
}
class Perfil {
  -id : int
  -tituloProfissional : String
  -bio : String
  -dataNascimento : Date
  -cidade : String
  -uf : String
  -nomeFantasia : String
  -cnpj : String
  -setor : String
  -site : String
  -habilidades : String
  -experiencias : String
  -formacao : String
  -cursosComplementares : String
  -informacoesAdicionais : String
  -idiomas : String
  -competencias : String
  -nivelExperiencia : String
  -disponibilidade : String
  -objetivo : String
  -links : String
  -cnh : String
  -pretensaoSalarial : String
  -foto : String
  -publico : boolean
  -aceiteLgpd : boolean
  -aceiteEm : DateTime
  --
  +criar() : int
  +salvar() : boolean
  +buscarPorUsuario(id) : Perfil
  +listarTalentos(termo, cidade) : List
}
class Curriculo {
  -id : int
  -titulo : String
  -arquivoPdf : String
  -arquivoTipo : String
  -curriculoTexto : String
  -template : String
  -downloads : int
  -createdAt : DateTime
  --
  +salvar() : int
  +excluir() : boolean
  +registrarDownload() : void
}
class Candidatura {
  -id : int
  -cartaApresentacao : String
  -status : String
  -observacaoEmpresa : String
  -dataCandidatura : DateTime
  -dataAtualizacao : DateTime
  --
  +enviarComLimite(limite) : String
  +atualizarStatus(status, obs) : boolean
  +cancelar() : boolean
  +excluir() : boolean
}
class Vaga {
  -id : int
  -titulo : String
  -anunciante : String
  -descricao : String
  -requisitos : String
  -beneficios : String
  -contato : String
  -tipoVaga : String
  -nivelExperiencia : String
  -remoto : String
  -cidade : String
  -uf : String
  -salarioMinimo : decimal
  -salarioMaximo : decimal
  -imagem : String
  -status : String
  -destaque : boolean
  -dataPublicacao : Date
  -dataExpiracao : Date
  -visualizacoes : int
  --
  +salvarComLimite(dados, limite) : int
  +excluir() : boolean
  +listar(filtros) : List
  +buscarParecida(titulo, anunciante, cidade) : Vaga
  +estaAberta() : boolean
  +incrementarVisualizacao() : void
}
class Match {
  -id : int
  -pontuacao : decimal
  -nivel : String
  -detalhes : JSON
  -visualizado : boolean
  --
  +salvar() : void
  +classificar(pontos) : String
}
class Categoria {
  -id : int
  -nome : String
  -tipo : String
  -ativo : boolean
  --
  +salvar() : int
  +excluir() : boolean
  +listar(tipo) : List
}
class Curso {
  -id : int
  -titulo : String
  -descricao : String
  -tipo : String
  -modalidade : String
  -nivel : String
  -duracao : String
  -gratuito : boolean
  -preco : decimal
  -url : String
  -imagem : String
  -instituicao : String
  -ativo : boolean
  --
  +salvar() : int
  +excluir() : boolean
  +listar(filtros) : List
  +guardarNaBiblioteca(pdf, descricao) : boolean
}
class Assinatura {
  -id : int
  -plano : String
  -valor : decimal
  -dataInicio : Date
  -dataFim : Date
  -status : String
  --
  +assinar(plano, valor) : boolean
  +cancelar() : boolean
  +podeCandidatar() : boolean
  +podePublicarVaga() : boolean
}
class RedefinicaoSenha {
  -id : int
  -tokenHash : String
  -expiraEm : DateTime
  -usadoEm : DateTime
  -ip : String
  --
  +criarToken() : String
}
class TentativaLogin {
  -id : int
  -ip : String
  -email : String
  -createdAt : DateTime
  --
  +registrarFalha() : void
  +minutosBloqueio() : int
}
class TermoCalibrado {
  -id : int
  -contexto : String
  -termo : String
  -termoChave : String
  -destino : String
  -ativo : boolean
  -createdAt : DateTime
  -updatedAt : DateTime
  --
  +salvar() : int
  +alterarAtivo(ativo) : boolean
  +excluir() : boolean
  +listarAtivos() : List
}
Usuario "1" -- "0..1" Perfil : possui >
Usuario "1" -- "0..*" Assinatura : contrata >
Usuario "1" -- "0..*" RedefinicaoSenha : solicita >
Usuario "0..1" -- "0..*" TermoCalibrado : cadastra >
Perfil "1" -- "0..*" Curriculo : envia >
Perfil "1" -- "0..*" Vaga : publica >
Perfil "1" -- "0..*" Candidatura : realiza >
Perfil "1" -- "0..*" Match
Vaga "1" -- "0..*" Candidatura : recebe >
Vaga "1" -- "0..*" Match
Curriculo "0..1" -- "0..*" Candidatura : anexado em >
Categoria "0..1" -- "0..*" Vaga : classifica >
Categoria "0..1" -- "0..*" Curso : classifica >
@enduml
