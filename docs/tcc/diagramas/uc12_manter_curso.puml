@startuml
!include estilo.iuml
mainframe uc Manter curso/e-book
left to right direction
actor Administrador as A
rectangle "Conecta Vagas DF" {
  usecase "Cadastrar curso/e-book" as C
  usecase "Extrair do texto ou da\nficha da pesquisa" as X
  usecase "Importar fichas em lote\n(prévia)" as L
  usecase "Guardar o PDF na\nbiblioteca" as G
  usecase "Alterar curso/e-book" as U
  usecase "Publicar / ocultar" as P
  usecase "Excluir curso/e-book" as E
  usecase "Trazer os PDFs para\na biblioteca" as T
  usecase "Aplicar o calibrador\n(termos e instituições\njá cadastradas)" as CB
}
A -- C
A -- U
A -- P
A -- E
A -- T
C <.. X : <<extend>>
C <.. L : <<extend>>
C <.. G : <<extend>>
X ..> CB : <<include>>
@enduml
