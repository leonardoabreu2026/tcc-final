@startuml
!include estilo.iuml
mainframe sd Excluir a própria conta (LGPD)
autonumber "0:"
hide footbox

actor Candidato as A
boundary ":TelaPerfil" as T
control ":PerfilController" as C
entity ":UsuarioDAO" as D
A -> T ++ : abrir "Excluir minha conta",\ndigitar a senha e confirmar
T -> C ++ : excluirConta(senha, confirmo)
C -> C : validar_csrf()
C -> D ++ : minutosBloqueioLogin(ip, email)
D --> C -- : 0 (sem pausa)
C -> D ++ : senhaConfere(id, senha)
D --> C -- : true
C -> D ++ : excluir(id)
D --> C -- : true (perfil, currículos, candidaturas,\nmatches, assinaturas, arquivos e\ntentativas de login saem junto)
C -> C : encerrar_sessao()
C --> T -- : "Sua conta e todos os seus dados\nforam excluídos da plataforma."
T --> A -- : exibir página inicial
@enduml
