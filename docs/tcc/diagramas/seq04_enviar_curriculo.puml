@startuml
!include estilo.iuml
mainframe sd Enviar currículo
autonumber "0:"
hide footbox

actor Candidato as A
boundary ":TelaPerfil" as T
control ":CurriculoController" as C
control ":LeitorDocumento" as L
control ":ExtracaoCurriculo" as X
control ":Calibrador" as K
entity ":CurriculoDAO" as CV
control ":AplicacaoCurriculo" as AP
control ":MatchService" as M
A -> T ++ : selecionar arquivo (PDF/DOC/DOCX)
T -> C ++ : upload(arquivo)
C -> C : validar tamanho, extensão e conteúdo
C -> L ++ : ler texto e foto do arquivo
L --> C -- : texto e foto
C -> X ++ : extrair(texto)
X -> K ++ : decidir("curriculo_linha", linha solta)
K --> X -- : seção do termo calibrado
X --> C -- : dados do currículo
C -> CV ++ : salvar(currículo)
CV --> C -- : curriculoId
C -> AP ++ : calcular(perfil, dados) / salvarFoto()
AP --> C -- : campos aplicados
C -> M ++ : recalcular(perfilId)
M --> C -- : nº de vagas analisadas
C --> T -- : relatório da extração
T --> A -- : exibir relatório
@enduml
