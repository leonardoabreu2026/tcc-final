@startuml
!include estilo.iuml
mainframe uc Perfil do candidato
left to right direction
actor Candidato as C
rectangle "Conecta Vagas DF" {
  usecase "Enviar currículo" as EC
  usecase "Extrair dados e foto\ndo currículo" as EX
  usecase "Alterar perfil\n(cadastro)" as AP
  usecase "Aplicar dados\ndo relatório" as AR
  usecase "Excluir currículo" as XC
  usecase "Visualizar portfólio" as VP
  usecase "Recalcular match" as RM
  usecase "Aplicar o calibrador\n(termos do administrador)" as CB
  usecase "Excluir a própria conta\n(LGPD)" as XA
  usecase "Confirmar com a senha" as CS
}
C -- EC
C -- AP
C -- AR
C -- XC
C -- VP
C -- XA
EC ..> EX : <<include>>
AP ..> RM : <<include>>
EX ..> CB : <<include>>
VP <.. RM : <<extend>>
XA ..> CS : <<include>>
@enduml
