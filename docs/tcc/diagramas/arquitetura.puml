@startuml
!include estilo.iuml
mainframe cmp Arquitetura MVC
skinparam componentStyle uml2
actor "Navegador\n(Candidato / Empresa /\nAdministrador)" as NAV
node "Navegador do usuário" {
  [assets/js/app.js\n(carregador, confirmações)] as JS
  [Leitor de cartaz\n(Tesseract.js em WebAssembly)] as OCR
}
node "Servidor Apache (XAMPP) + PHP 8.0 ou superior" {
  [.htaccess\n(mod_rewrite)] as HT
  [public/index.php\nFront Controller] as FC
  package "app/Core" {
    [Router] as R
    [Session / Auth / Csrf] as S
    [Database (PDO Singleton)] as DB
    [View / Upload / helpers] as V
  }
  package "app/Controllers (C) — 12" {
    [Home · Vaga · Curso · Planos\nAuth · Password] as CP
    [Perfil · Currículo\nCandidatura · Arquivo] as CC
    [Admin · Empresa] as CA
  }
  package "app/Services (regras de negócio)" {
    [Extracao: LeitorDocumento · PdfTexto · DocxTexto\nOcrImagem · ExtracaoCurriculo/Vaga/Curso\nImagemRemota · CapaPdf · FontesCursos\nPromptsPesquisa] as EX
    [Extracao/PadroesExtracao\n(padrões montados na hora das vagas\ne cursos cadastrados + nomes conhecidos)] as PAD
    [MatchService · Competencias\nPortfolio · Pix] as MS
  }
  package "app/Views (V)" {
    [layouts · partials · home · vagas\ncursos · perfil · auth · planos · admin] as VW
  }
  package "app/Models (M) — DAO" {
    [UsuarioDAO · PerfilDAO · VagaDAO · CursoDAO\nCategoriaDAO · CurriculoDAO · CandidaturaDAO\nMatchDAO · AssinaturaDAO] as DAO
  }
  [Leitor de PDF do Windows\n(PowerShell: capa-pdf.ps1)] as PS
  folder "storage/uploads\n(currículos, fotos, cartazes,\nPDFs da biblioteca)" as UP
}
database "MySQL / MariaDB\ntcc_final\n(11 tabelas)" as BD
cloud "Sites oficiais\n(imagens e PDFs\ndos cursos)" as WEB
NAV --> HT : HTTP
NAV ..> OCR
OCR ..> FC : leituras do cartaz (TSV)
HT --> FC
FC --> R
FC --> S
R --> CP
R --> CC
R --> CA
CP --> VW
CC --> EX
CC --> MS
CA --> EX
EX ..> PAD : onde a regra\nnão tem pista
PAD ..> DB : lê vagas, cursos\ne empresas
EX ..> PS : capa da 1ª página\ndo PDF (CapaPdf)
CA --> DAO
CC --> DAO
CP --> DAO
DAO --> DB
DB --> BD
EX ..> UP
EX ..> WEB : HTTPS verificado,\nsó IP público
@enduml
