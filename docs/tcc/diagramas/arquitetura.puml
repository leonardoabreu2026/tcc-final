@startuml
!include estilo.iuml
mainframe cmp Arquitetura MVC
skinparam componentStyle uml2
actor "Navegador\n(Visitante / Candidato /\nEmpresa / Administrador)" as NAV
node "Navegador do usuário" {
  [assets/js/app.js\n(carregador, confirmações)] as JS
  [Leitor de cartaz\n(Tesseract.js em WebAssembly)] as OCR
}
node "Servidor Apache (XAMPP) + PHP 8.0 ou superior" {
  [.htaccess\n(mod_rewrite)] as HT
  [public/index.php\nFront Controller] as FC
  package "app/Core" {
    [Router] as R
    [Session / Auth / Csrf] as S
    [Database (PDO Singleton)] as DB
    [View / Upload / helpers] as V
  }
  package "app/Controllers (C) — 13" {
    [Home · Vaga · Curso · Planos\nAuth · Password] as CP
    [Perfil · Currículo\nCandidatura · Arquivo] as CC
    [Admin · Empresa · Calibrador] as CA
  }
  package "app/Services (regras de negócio)" {
    [Extracao: LeitorDocumento · PdfTexto · DocxTexto\nOcrImagem · ExtracaoCurriculo/Vaga/Curso\nImagemRemota · FontesCursos · PromptsPesquisa] as EX
    [Extracao/Calibrador\n(termos do administrador +\nnomes já cadastrados)] as CAL
    [MatchService · Competencias\nPortfolio · Pix] as MS
  }
  package "app/Views (V)" {
    [layouts · partials · home · vagas\ncursos · perfil · auth · planos · admin] as VW
  }
  package "app/Models (M) — DAO" {
    [UsuarioDAO · PerfilDAO · VagaDAO · CursoDAO\nCategoriaDAO · CurriculoDAO · CandidaturaDAO\nMatchDAO · AssinaturaDAO · CalibracaoDAO] as DAO
  }
  folder "storage/uploads\n(currículos, fotos, cartazes,\nPDFs da biblioteca)" as UP
}
database "MySQL / MariaDB\ntcc_final\n(12 tabelas)" as BD
cloud "Sites oficiais\n(imagens e PDFs\ndos cursos)" as WEB
NAV --> HT : HTTP
NAV ..> OCR
OCR ..> FC : leituras do cartaz (TSV)
HT --> FC
FC --> R
FC --> S
R --> CP
R --> CC
R --> CA
CP --> VW
CC --> EX
CC --> MS
CA --> EX
CA --> CAL
EX ..> CAL : ajustes
CAL ..> DAO
CA --> DAO
CC --> DAO
CP --> DAO
DAO --> DB
DB --> BD
EX ..> UP
EX ..> WEB : HTTPS verificado,\nsó IP público
@enduml
